# Neve26 Environment Configuration
# Copy this to .env and fill in values

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
# For local development with Docker:
DATABASE_URL=postgresql://neve26:neve26@localhost:5432/neve26

# For Supabase (production):
# DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# Proxy configuration (for scraping)
PROXY_PROVIDER=none
PROXY_USERNAME=
PROXY_PASSWORD=

# Push notifications
FIREBASE_CREDENTIALS_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# API settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# Scraper
SCRAPE_ENABLED=true
