{
  "expo": {
    "name": "Neve26",
    "slug": "neve26",
    "owner": "neve26",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "neve26",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#008C45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neve26.app",
      "buildNumber": "1",
      "associatedDomains": ["applinks:neve26.com"],
      "infoPlist": {
        "NSUserTrackingUsageDescription": "We do not track users. This disclosure is required by Apple for transparency."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#008C45"
      },
      "package": "com.neve26.app",
      "versionCode": 1,
      "permissions": ["RECEIVE_BOOT_COMPLETED"],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyTracking": false,
              "NSPrivacyCollectedDataTypes": [],
              "NSPrivacyTrackingDomains": [],
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
                }
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.neve26.com"
    }
  }
}
